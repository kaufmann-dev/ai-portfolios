# PostgreSQL connection string
DATABASE_URL="postgres://user:password@host:5432/ai_portfolios"
# Public URL of the app (adapter-node and Better Auth)
ORIGIN="http://localhost:5173"
# Random secret for Better Auth, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Pocket ID issuer URL and OIDC client credentials
POCKET_ID_ISSUER="https://id.example.com"
POCKET_ID_CLIENT_ID=""
POCKET_ID_CLIENT_SECRET=""
# Massive.com API key for prices, splits, dividends, and ticker reference data
MASSIVE_API_KEY=""
# Optional: minutes between market-data refresh runs (default 10)
REFRESH_INTERVAL_MINUTES=""
